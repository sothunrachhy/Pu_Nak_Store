generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id        String   @id @default(cuid())
  name      String
  category  String?
  size      String?
  color     String?
  image     String?  @db.Text
  costPrice Decimal  @db.Decimal(10, 2)
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Items the shop no longer stocks are archived rather than deleted: a Sale
  // points at its Item, so deleting one would take its sales history - and the
  // income and cost-of-goods totals built from it - with it.
  archivedAt DateTime?

  sales Sale[]

  @@index([name])
  @@index([archivedAt])
}

model Sale {
  id         String   @id @default(cuid())
  item       Item     @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  total      Decimal  @db.Decimal(10, 2)
  costPrice  Decimal  @db.Decimal(10, 2)
  costTotal  Decimal  @db.Decimal(10, 2)
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([itemId])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  note        String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
